{
  "name": "yudao-ai-desk-react",
  "version": "1.2.0",
  "private": true,
  "description": "Yudao AI Desk | AI Agent 桌面客户端",
  "homepage": "https://gitee.com/yudaocode/yudao-ai-desk",
  "main": "./out/main/index.js",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/",
    "electron_builder_binaries_mirror": "https://npmmirror.com/mirrors/electron-builder-binaries/"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run type-check && electron-vite build",
    "type-check": "npm run type-check:node && npm run type-check:web",
    "type-check:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "type-check:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "pack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac --arm64",
    "build:win": "npm run build && electron-builder --win --x64 --config.npmRebuild=false",
    "postinstall": "install-electron && electron-builder install-app-deps && node scripts/fix-node-pty-perms.cjs",
    "test": "vitest run",
    "test:electron": "playwright test",
    "test:package": "node tests/package-smoke.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "electron-log": "5.4.4",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@ant-design/icons": "6.3.4",
    "@playwright/test": "^1.59.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "antd": "6.6.5",
    "dompurify": "3.4.17",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "15.0.3",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.15.0",
    "sass-embedded": "1.105.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^4.1.0",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
